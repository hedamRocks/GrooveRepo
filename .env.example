# Database
DATABASE_URL="postgresql://user:password@localhost:5432/vinyl_collection?schema=public"

# Discogs API
# Get these from: https://www.discogs.com/settings/developers
DISCOGS_CONSUMER_KEY="your_consumer_key"
DISCOGS_CONSUMER_SECRET="your_consumer_secret"
DISCOGS_CALLBACK_URL="http://localhost:3000/api/discogs/oauth-callback"

# Auth
# Generate a random string for session encryption
SESSION_SECRET="generate_a_random_32_char_string"

# Email (for magic links)
# Using Resend as example - swap for SendGrid, Postmark, etc.
EMAIL_FROM="noreply@yourdomain.com"
RESEND_API_KEY="re_..."

# App
BASE_URL="http://localhost:3000"

# YouTube (DJ analysis + audio player) — used by the worker
YOUTUBE_API_KEY="your_youtube_data_api_v3_key"
# Optional: cookies.txt export to dodge bot-checks on yt-dlp
# YOUTUBE_COOKIES_PATH="/path/to/youtube-cookies.txt"

# Cloudflare R2 (dual-deck audio cache). Leave unset for local-only streaming.
# App (Vercel) needs these to presign/redirect; worker needs them to upload.
R2_ACCOUNT_ID="your_cloudflare_account_id"
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
R2_BUCKET="groove-audio"
